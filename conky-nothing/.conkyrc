-- Nothing Phone-Inspired Conky Widget Configuration
-- Minimalist design with monochromatic palette

conky.config = {
    -- Window settings
    alignment = 'top_right',
    gap_x = 30,
    gap_y = 50,
    minimum_width = 280,
    maximum_width = 280,
    minimum_height = 600,

    -- Background and border
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 180,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_colour = '0x0a0a0a',

    -- No border
    draw_borders = false,
    draw_graph_borders = false,
    border_width = 0,

    -- Double buffering to reduce flicker
    double_buffer = true,
    no_buffers = true,

    -- Update interval in seconds
    update_interval = 2,

    -- Font settings
    use_xft = true,
    font = 'JetBrains Mono:size=10',
    xftalpha = 1,
    override_utf8_locale = true,

    -- Text colors (monochromatic)
    default_color = 'EEEEEE',
    default_shade_color = '000000',
    default_outline_color = '000000',
    color0 = 'FFFFFF',  -- primary text
    color1 = 'AAAAAA',  -- secondary text
    color2 = '555555',  -- dim text / separators
    color3 = 'CCCCCC',  -- accent / progress bars
    color4 = '333333',  -- bar background

    -- Shading and outline
    draw_shades = false,
    draw_outline = false,

    -- Lua integration
    lua_load = '~/.config/conky/conky_nothing.lua',
    lua_draw_hook_pre = 'draw_background',

    -- CPU averaging
    cpu_avg_samples = 4,
    net_avg_samples = 2,

    -- Misc
    out_to_console = false,
    out_to_stderr = false,
    extra_newline = false,
    uppercase = false,
    short_units = true,
    pad_percents = 2,
    temperature_unit = 'celsius',
}

conky.text = [[
${lua_parse header}
${font JetBrains Mono:size=36:bold}${color0}${time %H:%M}${font}
${font JetBrains Mono:size=11}${color1}${time %A, %B %d}${font}
${color2}${hr 1}${color}

${font JetBrains Mono:size=9:bold}${color1}SYSTEM${font}
${color2}${hr 1}${color}

${font JetBrains Mono:size=9}${color1}CPU${font}   ${color0}${cpu cpu0}%${color}
${color4}${cpubar cpu0 6,280}${color}

${font JetBrains Mono:size=9}${color1}MEM${font}   ${color0}${memperc}%  ${color1}${mem} / ${memmax}${color}
${color4}${membar 6,280}${color}

${font JetBrains Mono:size=9}${color1}DISK${font}  ${color0}${fs_used_perc /}%  ${color1}${fs_used /} / ${fs_size /}${color}
${color4}${fs_bar 6,280 /}${color}

${color2}${hr 1}${color}
${font JetBrains Mono:size=9:bold}${color1}CPU CORES${font}
${color2}${hr 1}${color}

${font JetBrains Mono:size=9}${color1}Core 1${font}  ${color0}${cpu cpu1}%${color1}  Core 2${font}  ${color0}${cpu cpu2}%${color}
${color4}${cpubar cpu1 4,136}${color}  ${color4}${cpubar cpu2 4,136}${color}
${font JetBrains Mono:size=9}${color1}Core 3${font}  ${color0}${cpu cpu3}%${color1}  Core 4${font}  ${color0}${cpu cpu4}%${color}
${color4}${cpubar cpu3 4,136}${color}  ${color4}${cpubar cpu4 4,136}${color}

${color2}${hr 1}${color}
${font JetBrains Mono:size=9:bold}${color1}BATTERY${font}
${color2}${hr 1}${color}

${font JetBrains Mono:size=9}${color1}Charge${font}  ${color0}${battery_percent BAT0}%  ${color1}${battery_time BAT0}  ${battery BAT0}${color}
${color4}${battery_bar 6,280 BAT0}${color}

${color2}${hr 1}${color}
${font JetBrains Mono:size=9:bold}${color1}NETWORK${font}
${color2}${hr 1}${color}

${font JetBrains Mono:size=9}${color1}UP${font}    ${color0}${upspeed}   ${color1}DOWN${font}  ${color0}${downspeed}${color}
${font JetBrains Mono:size=9}${color1}IP${font}    ${color0}${addr wlan0}${color}

${color2}${hr 1}${color}
${font JetBrains Mono:size=9:bold}${color1}NOW PLAYING${font}
${color2}${hr 1}${color}

${font JetBrains Mono:size=9}${color0}${exec playerctl metadata title 2>/dev/null | head -c 34 || echo "Nothing playing"}${color}
${font JetBrains Mono:size=8}${color1}${exec playerctl metadata artist 2>/dev/null | head -c 34 || echo "—"}${color}
${font JetBrains Mono:size=8}${color2}${exec playerctl status 2>/dev/null || echo "Stopped"}${color}

${color2}${hr 1}${color}
${font JetBrains Mono:size=8}${color2}uptime ${color1}${uptime}${color}
]]
