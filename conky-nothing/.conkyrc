-- Nothing Phone-Inspired Conky Widget Configuration
-- Minimalist design with monochromatic palette

conky.config = {
    -- Window settings
    alignment = 'top_right',
    gap_x = 30,
    gap_y = 50,
    minimum_width = 280,
    maximum_width = 280,
    minimum_height = 660,

    -- Background and border
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 230,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_colour = '000000',

    -- No border
    draw_borders = false,
    draw_graph_borders = false,
    border_width = 0,

    -- Double buffering to reduce flicker
    double_buffer = true,
    no_buffers = true,

    -- Update interval in seconds
    update_interval = 1,

    -- Font settings
    use_xft = true,
    font = 'JetBrains Mono:size=9',
    xftalpha = 1,

    -- Text colors (monochromatic Nothing Phone palette)
    default_color = 'F5F5F5',
    default_shade_color = '000000',
    default_outline_color = '000000',
    color0 = 'F5F5F5',  -- primary text
    color1 = '888888',  -- secondary / label text
    color2 = '333333',  -- dim text / separators
    color3 = 'E0E0E0',  -- accent / progress bars (fill)
    color4 = '222222',  -- bar background reference

    -- Shading and outline
    draw_shades = false,
    draw_outline = false,

    -- Lua integration
    lua_load = '~/.config/conky/conky_nothing.lua',
    lua_draw_hook_pre = 'draw_background',

    -- CPU averaging
    cpu_avg_samples = 4,
    net_avg_samples = 2,

    -- Misc
    out_to_console = false,
    out_to_stderr = false,
    extra_newline = false,
    uppercase = false,
    short_units = true,
    pad_percents = 2,
    temperature_unit = 'celsius',
}

conky.text = [[
${lua_parse header}
${voffset 28}${font JetBrains Mono:size=38:bold}${color0}${alignc}${time %H:%M}${font}
${font JetBrains Mono:size=10}${color1}${alignc}${time %A, %B %d}${font}
${voffset 8}${color2}${hr 1}${color}

${voffset 2}${font JetBrains Mono:size=8:bold}${color1}SYSTEM${font}
${voffset 2}${font JetBrains Mono:size=9}${color1}CPU   ${color0}${cpu cpu0}%${color}
${color3}${cpubar 5,260 cpu0}${color}
${font JetBrains Mono:size=9}${color1}MEM   ${color0}${memperc}%  ${color1}${mem} / ${memmax}${color}
${color3}${membar 5,260}${color}
${font JetBrains Mono:size=9}${color1}DISK  ${color0}${fs_used_perc /}%  ${color1}${fs_used /} / ${fs_size /}${color}
${color3}${fs_bar 5,260 /}${color}

${voffset 4}${font JetBrains Mono:size=8:bold}${color1}CPU CORES${font}
${voffset 2}${font JetBrains Mono:size=8}${color1}Core 1 ${color0}${cpu cpu1}%  ${color1}Core 2 ${color0}${cpu cpu2}%${color}
${color3}${cpubar 4,124 cpu1}${color}  ${color3}${cpubar 4,124 cpu2}${color}
${font JetBrains Mono:size=8}${color1}Core 3 ${color0}${cpu cpu3}%  ${color1}Core 4 ${color0}${cpu cpu4}%${color}
${color3}${cpubar 4,124 cpu3}${color}  ${color3}${cpubar 4,124 cpu4}${color}

${voffset 4}${font JetBrains Mono:size=8:bold}${color1}BATTERY${font}
${voffset 2}${font JetBrains Mono:size=9}${color0}${battery_percent BAT0}%  ${color1}${battery_time BAT0}  ${battery BAT0}${color}
${color3}${battery_bar 5,260 BAT0}${color}

${voffset 4}${font JetBrains Mono:size=8:bold}${color1}NETWORK${font}
${voffset 2}${font JetBrains Mono:size=9}${color1}UP ${color0}${upspeed wlan0}   ${color1}DOWN ${color0}${downspeed wlan0}${color}
${font JetBrains Mono:size=8}${color1}IP  ${color0}${addr wlan0}${color}

${voffset 4}${font JetBrains Mono:size=8:bold}${color1}NOW PLAYING${font}
${voffset 2}${font JetBrains Mono:size=9}${color0}${exec playerctl metadata title 2>/dev/null | cut -c1-30 || echo "Nothing playing"}${color}
${font JetBrains Mono:size=8}${color1}${exec playerctl metadata artist 2>/dev/null | cut -c1-30 || echo "--"}${color}
${font JetBrains Mono:size=8}${color2}${exec playerctl status 2>/dev/null || echo "Stopped"}${color}

${voffset 10}${font JetBrains Mono:size=8}${color2}uptime  ${color1}${uptime}${color}
]]
